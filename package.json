{
    "name": "algorithme-tn-runner",
    "displayName": "Algorithme TN — Exécuteur & Tableaux",
    "description": "Exécute les fichiers .algo (pseudocode tunisien) en Python, avec éditeur de tableaux de déclaration. Fork de algorithme-tn (les-profs-d-info), sous licence GPL-3.0.",
    "version": "0.0.8",
    "icon": "images/icon.png",
    "engines": {
        "vscode": "^1.38.0"
    },
    "publisher": "MajdLHB",
    "author": {
        "name": "Majd Lahbib"
    },
    "license": "GPL-3.0",
    "categories": [
        "Programming Languages"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:algo"
    ],
    "contributes": {
        "commands": [
            {
                "command": "algo.run",
                "title": "Exécuter l'algorithme",
                "category": "Algorithme",
                "icon": "$(play)"
            },
            {
                "command": "algo.translate",
                "title": "Traduire en Python (sans exécuter)",
                "category": "Algorithme",
                "icon": "$(file-code)"
            },
            {
                "command": "algo.editerTables",
                "title": "Éditer les tableaux de déclaration (TDO)",
                "category": "Algorithme",
                "icon": "$(table)"
            },
            {
                "command": "algo.ajouterObjet",
                "title": "Ajouter un objet au TDO",
                "category": "Algorithme"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "algo.run",
                    "when": "editorLangId == algo",
                    "group": "navigation@1"
                },
                {
                    "command": "algo.translate",
                    "when": "editorLangId == algo",
                    "group": "navigation@2"
                },
                {
                    "command": "algo.editerTables",
                    "when": "editorLangId == algo",
                    "group": "navigation@3"
                }
            ],
            "editor/context": [
                {
                    "command": "algo.run",
                    "when": "editorLangId == algo",
                    "group": "algo@1"
                },
                {
                    "command": "algo.translate",
                    "when": "editorLangId == algo",
                    "group": "algo@2"
                },
                {
                    "command": "algo.editerTables",
                    "when": "editorLangId == algo",
                    "group": "algo@3"
                },
                {
                    "command": "algo.ajouterObjet",
                    "when": "editorLangId == algo",
                    "group": "algo@4"
                }
            ]
        },
        "keybindings": [
            {
                "command": "algo.run",
                "key": "f5",
                "when": "editorLangId == algo && !inDebugMode"
            },
            {
                "command": "algo.run",
                "key": "ctrl+f5",
                "when": "editorLangId == algo"
            },
            {
                "command": "algo.translate",
                "key": "ctrl+alt+p",
                "when": "editorLangId == algo"
            },
            {
                "command": "algo.editerTables",
                "key": "ctrl+alt+t",
                "when": "editorLangId == algo"
            },
            {
                "command": "algo.ajouterObjet",
                "key": "ctrl+alt+o",
                "when": "editorLangId == algo"
            }
        ],
        "configuration": {
            "title": "Algorithme-tn",
            "properties": {
                "algo.pythonPath": {
                    "type": "string",
                    "default": "python",
                    "description": "Interpréteur Python utilisé pour exécuter les fichiers .algo (ex : python, python3, py)."
                }
            }
        },
        "languages": [
            {
                "id": "algo",
                "aliases": [
                    "Algorithme en Pseudocode",
                    "algo"
                ],
                "extensions": [
                    ".algo",
                    ".alg"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "algo",
                "scopeName": "source.algo",
                "path": "./syntaxes/algo.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.python": "python",
                    "meta.embedded.block.javascript": "javascript"
                }
            }
        ],
        "snippets": [
            {
                "language": "algo",
                "path": "./snippets/base.json"
            },
            {
                "language": "algo",
                "path": "./snippets/x-snippets.json"
            }
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/MajdLHB/algo-tn-vscode.git"
    },
    "homepage": "https://github.com/MajdLHB/algo-tn-vscode",
    "bugs": {
        "url": "https://github.com/MajdLHB/algo-tn-vscode/issues"
    }
}
